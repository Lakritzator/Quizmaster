{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quizmaster Quiz Schema",
  "description": "JSON schema for Quizmaster quiz files",
  "type": "object",
  "required": ["title", "questions"],
  "properties": {
    "title": {
      "type": "string",
      "description": "The title of the quiz"
    },
    "text": {
      "type": "string",
      "description": "A description or introduction text for the quiz"
    },
    "textHtml": {
      "type": "string",
      "description": "Optional HTML formatted version of the text"
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the quiz",
      "additionalProperties": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "description": "List of questions in this quiz",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "answers"],
        "properties": {
          "text": {
            "type": "string",
            "description": "The question text"
          },
          "textHtml": {
            "type": "string",
            "description": "Optional HTML formatted version of the question text"
          },
          "imageFileName": {
            "type": "string",
            "description": "Optional image filename (relative to the zip file)"
          },
          "answers": {
            "type": "array",
            "description": "List of possible answers",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["text", "isCorrect"],
              "properties": {
                "text": {
                  "type": "string",
                  "description": "The answer text"
                },
                "textHtml": {
                  "type": "string",
                  "description": "Optional HTML formatted version of the answer text"
                },
                "isCorrect": {
                  "type": "boolean",
                  "description": "Indicates whether this is the correct answer"
                }
              }
            }
          },
          "explanation": {
            "type": "string",
            "description": "Optional explanation shown after answering"
          },
          "explanationHtml": {
            "type": "string",
            "description": "Optional HTML formatted explanation"
          }
        }
      }
    }
  }
}
